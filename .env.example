# === Docker Compose & Aplikasi ===

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cafe_pos
POSTGRES_PORT=5432

# Backend (di dalam network compose, hostname "postgres")
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/cafe_pos?schema=public"
JWT_SECRET="CHANGE_ME_generate_a_long_random_secret"
# Origin frontend yang boleh memanggil API (pisahkan dengan koma bila lebih dari satu).
CORS_ORIGIN="http://localhost:5173"
# Port host untuk backend (ubah jika 3000 dipakai proses lain)
BACKEND_PORT=3000

# Kredensial seed (WAJIB diisi — container backend gagal start tanpa ini
# bila seed dijalankan; set SKIP_SEED=1 bila DB sudah berisi data).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_CASHIER_USERNAME=kasir1
SEED_CASHIER_PASSWORD=

# Entrypoint backend: set 1 untuk melewati migrasi / seed
SKIP_MIGRATE=0
SKIP_SEED=0
